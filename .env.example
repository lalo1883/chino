# Public Firebase web configuration (already defaults to chino-web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=chino-web.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=chino-web
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=chino-web.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=540610863000
NEXT_PUBLIC_FIREBASE_APP_ID=1:540610863000:web:f32cab6b916c172e2bd5ed

# One-time import only; never used by the browser or deployed app
DATABASE_URL=
GOOGLE_APPLICATION_CREDENTIALS=

# Server-only, for exact account counts in /admin when deployed.
# A Firebase service account JSON for chino-web, with Firebase Authentication Viewer.
# Never use NEXT_PUBLIC_ for this credential.
FIREBASE_SERVICE_ACCOUNT_JSON=
